---
interface Props {
  bookingTitle: string;
  bookingSubtitle: string;
}

const { bookingTitle, bookingSubtitle } = Astro.props;
---

<section class="booking-panel" id="booking-panel" aria-label="Book a call">
  <h2 class="booking-title" id="booking-title">
    {bookingTitle}
    <span class="booking-subtitle">{bookingSubtitle}</span>
  </h2>
  <div id="my-cal-inline-shamelesss"></div>
</section>
